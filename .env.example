# =============================================================================
# Benne Direct — variables d'environnement (AUCUN SECRET DANS CE FICHIER)
# Copier en .env puis compléter. Les variables NEXT_PUBLIC_* sont visibles
# dans le navigateur : n'y mettez jamais de secret.
# =============================================================================

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Benne Direct"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Paris"
# Secret aléatoire ≥ 32 caractères (HMAC des liens de fichiers temporaires, etc.)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=""
# Protège /api/cron/* (déclenchement de la file de notifications en mode serverless)
CRON_SECRET=""

# --- Base de données (PostgreSQL ≥ 14) ---------------------------------------
DATABASE_URL="postgresql://benne:benne@localhost:5432/bennedirect"
# URL directe pour les migrations. Identique à DATABASE_URL en local/serveur classique.
# Supabase + Netlify : DATABASE_URL = pooler « transaction » (port 6543, ?pgbouncer=true&connection_limit=1),
# DIRECT_URL = pooler « session » (port 5432).
DIRECT_URL="postgresql://benne:benne@localhost:5432/bennedirect"

# --- Stripe (mode TEST pendant le développement : sk_test_... / whsec_...) ----
# Requis pour vendre des packs. Sans ces clés, l'achat est désactivé et signalé.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Moyens de paiement Checkout (séparés par des virgules). "card" seul par défaut ;
# ajoutez "sepa_debit" pour tester les paiements différés.
STRIPE_PAYMENT_METHODS="card"

# --- Email transactionnel (SMTP générique : Brevo, Mailjet, Scaleway TEM, ...) -
# Sans SMTP_HOST, aucun email n'est envoyé ; les notifications sont marquées
# « non configuré » et la vérification par email est impossible en production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- SMS (facultatif) --------------------------------------------------------
# SMS_PROVIDER = none | twilio
SMS_PROVIDER="none"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Garde-fous de coût
SMS_DAILY_CAP="50"
SMS_PER_COMPANY_DAILY_CAP="5"

# --- Web Push (facultatif) ---------------------------------------------------
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Anti-spam (facultatif) : Cloudflare Turnstile -----------------------------
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Stockage des fichiers privés -------------------------------------------
# Répertoire local HORS du dossier public. En production : volume persistant.
STORAGE_DIR="./storage"

# --- Développement uniquement ----------------------------------------------
# Affiche les codes de vérification dans la console du serveur si aucun
# fournisseur email/SMS n'est configuré. Ignoré quand NODE_ENV=production.
DEV_LOG_OTP="true"
